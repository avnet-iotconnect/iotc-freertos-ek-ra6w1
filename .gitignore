# =============================================================================
# .gitignore for the Renesas RA6W1 (e² Studio + GCC) AWS-IoT-W project
#
# Goal: track ONLY source/config inputs; ignore everything that the toolchain,
# IDE, code-generator, or build system can re-create.
# =============================================================================

# ---- Build outputs ----------------------------------------------------------
Debug/
Release/
build/
out/
bin/
obj/

# Object / dependency / linker / map / image artifacts
*.o
*.obj
*.a
*.lib
*.lo
*.la
*.so
*.so.*
*.dylib
*.dll
*.exe
*.elf
*.elf.in
*.axf
*.bin
*.hex
*.srec
*.s19
*.s37
*.mot
*.map
*.lst
*.lss
*.sym
*.sbd
*.d
*.dep
*.gcno
*.gcda
*.gcov
*.su
*.i
*.s
*.ii
*.preprocessed
*.o.in

# CMake / Ninja (in case anyone adds it later)
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
compile_commands.json
.ninja_deps
.ninja_log

# Make
makefile.targets
makefile.defs

# ---- e² Studio / Eclipse ----------------------------------------------------
.metadata/
.settings/
.recommenders/
RemoteSystemsTempFiles/
.cproject
.project
*.launch
*.jlink
*.jdebug
*.jdebug.user
*.cspy
*.cspy.bat
*.cspy.ps1
*.dbgdt
*.dnx
*.ewd
*.ewp
*.ewt
*.eww
*.dep
*.options
*.checkpoint

# ---- Renesas Smart Configurator / RA FW Generator ---------------------------
# These directories are regenerated by the configurator from configuration.xml.
# Track configuration.xml only; ignore the generated trees.
rafw_gen/
ra_gen/
ra_cfg/
# Note: rafw_cfg/ is hand-edited in some BSPs — keep it tracked.
# If your project regenerates rafw_cfg/ as well, uncomment the next line:
#rafw_cfg/

# RA project trash
.api/
.lib/
.module_descriptions/
ra/.api_versions

# ---- Toolchain / debugger temp files ----------------------------------------
*.tmp
*.bak
*.old
*.orig
*.rej
*.swp
*.swo
*.pyc
__pycache__/

# ---- IDE: VS Code / JetBrains / Vim / etc. ---------------------------------
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.iml
*.code-workspace
*~
*.sublime-*

# ---- OS noise ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ---- Local secrets / credentials -------------------------------------------
# Never commit private keys / certs / connection strings.
*.pem
*.key
*.crt.pem
*.p12
*.pfx
secrets/
local.config
*.local

# =============================================================================
# Explicit "DO TRACK" overrides
# =============================================================================
# Keep the generator's input file even though most of rafw_gen/ is ignored.
!configuration.xml

# Keep the linker scripts and post-build helpers (they live under script/).
!script/
!script/**

# Keep helper Python scripts.
!scripts/
!scripts/**
